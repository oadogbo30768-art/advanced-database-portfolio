-- Portfolio 2: Query Processing and Optimisation (MySQL 8.0)
-- DB: citylight_library (from Portfolio 1). Run top-to-bottom in Workbench.
USE citylight_library;

-- ============ Q1: Catalogue search (most common operation) ============
-- Find available Computing books by keyword
SELECT book_id, title, author, category, available_copies
FROM books
WHERE category = 'Computing' AND available_copies > 0
  AND (title LIKE '%Data%' OR author LIKE '%Data%')
ORDER BY title;

-- ============ Q2: Overdue loans with days overdue + fine estimate ============
-- Core librarian report: who is overdue, by how long
SELECT l.loan_id, m.full_name AS member, b.title,
       l.loan_date, l.due_date,
       DATEDIFF(CURDATE(), l.due_date) AS days_overdue,
       DATEDIFF(CURDATE(), l.due_date) * 100 AS estimated_fine_ngn
FROM loans l
JOIN members m ON m.member_id = l.member_id
JOIN books b ON b.book_id = l.book_id
WHERE l.status = 'overdue' OR (l.return_date IS NULL AND l.due_date < CURDATE())
ORDER BY days_overdue DESC;

-- ============ Q3: Member loan history + unpaid fines (transcript equivalent) ============
SELECT m.member_id, m.full_name, m.status,
       COUNT(l.loan_id) AS total_loans,
       SUM(CASE WHEN l.status = 'overdue' THEN 1 ELSE 0 END) AS overdue_count,
       COALESCE(SUM(CASE WHEN f.paid = 0 THEN f.amount ELSE 0 END), 0) AS unpaid_fines
FROM members m
LEFT JOIN loans l ON l.member_id = m.member_id
LEFT JOIN fines f ON f.loan_id = l.loan_id
GROUP BY m.member_id, m.full_name, m.status
ORDER BY unpaid_fines DESC;

-- ============ Q4: Most borrowed books (aggregation + ranking) ============
SELECT b.book_id, b.title, b.author,
       COUNT(l.loan_id) AS times_borrowed,
       RANK() OVER (ORDER BY COUNT(l.loan_id) DESC) AS popularity_rank
FROM books b
LEFT JOIN loans l ON l.book_id = b.book_id
GROUP BY b.book_id, b.title, b.author
ORDER BY times_borrowed DESC;

-- ============ Q5: Books never borrowed (anti-join, tests optimiser) ============
SELECT b.book_id, b.title, b.author
FROM books b
WHERE NOT EXISTS (SELECT 1 FROM loans l WHERE l.book_id = b.book_id);

-- ============ OPTIMISATION EVIDENCE ============
-- Step 1: Baseline execution plan BEFORE extra index (run + screenshot)
EXPLAIN FORMAT=TREE
SELECT * FROM loans WHERE member_id = 1 AND status = 'on_loan';

-- Step 2: Composite index for the most selective librarian lookup
-- (member + status is the real-world access path at the issue desk)
CREATE INDEX IF NOT EXISTS idx_loans_member_status ON loans(member_id, status);

-- Step 3: Plan AFTER index (run + screenshot — should show index range scan)
EXPLAIN FORMAT=TREE
SELECT * FROM loans WHERE member_id = 1 AND status = 'on_loan';

-- Step 4: Timed comparison with EXPLAIN ANALYZE (MySQL 8.0.18+)
EXPLAIN ANALYZE
SELECT l.loan_id, m.full_name, b.title
FROM loans l JOIN members m ON m.member_id = l.member_id
JOIN books b ON b.book_id = l.book_id
WHERE l.status = 'overdue';

-- Step 5: Index inventory for the report
SHOW INDEX FROM books;
SHOW INDEX FROM loans;

-- Optional: force optimiser comparison ( join order / index hint demo )
SELECT /*+ JOIN_ORDER(l, m, b) */ l.loan_id, m.full_name, b.title
FROM loans l JOIN members m ON m.member_id = l.member_id
JOIN books b ON b.book_id = l.book_id
WHERE l.status = 'overdue';
